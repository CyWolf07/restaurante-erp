# ═══════════════════════════════════════════════════════
#  SEGURIDAD: Solo usar paquetes con +30 dias de antiguedad
#  Proteccion contra ataques de supply chain en npm
# ═══════════════════════════════════════════════════════

# No ejecutar scripts post-install de dependencias (vector de ataque comun)
ignore-scripts=true

# Modo de resolucion basado en tiempo: prefiere versiones estables y probadas
resolution-mode=time-based

# Permitir dependencias opcionales (necesarias para binarios nativos como rollup)
optional=true

# Verificar integridad de paquetes
strict-peer-dependencies=false

# Lockfile estricto: en CI/produccion solo se usan versiones del lockfile
# (usar pnpm install --frozen-lockfile en produccion)

# Registro oficial unicamente (sin registros alternativos)
registry=https://registry.npmjs.org/

# No permitir paquetes sin checksum verificado
strict-ssl=true

# Limitar la profundidad de hoisting para evitar paquetes fantasma
hoist=true
shamefully-hoist=true

# Auto-install-peers para compatibilidad
auto-install-peers=true
