{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "author": "Ing. Josue Villacorte - Zenith",
    "packageManager": "pnpm@9.15.4",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "verify-deps": "node scripts/verify-package-age.mjs",
        "safe-install": "pnpm install --frozen-lockfile && pnpm run verify-deps && pnpm audit --audit-level=moderate",
        "preinstall": "node scripts/require-pnpm.mjs"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "axios": "^1.20.0",
        "concurrently": "^9.2.4",
        "laravel-vite-plugin": "^2.1.0",
        "tailwindcss": "^4.3.3",
        "vite": "^7.3.6",
        "yaml": "^2.8.3"
    },
    "pnpm": {
        "overrides": {},
        "peerDependencyRules": {
            "ignoreMissing": [],
            "allowAny": []
        }
    }
}
